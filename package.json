{
  "name": "tritonize-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "start": "bunx --bun vite",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "perf:serve": "bunx --bun vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "perf:bench": "node ./scripts/perf/run-perf.mjs",
    "test:perf": "bun run build && bun run perf:bench"
  },
  "dependencies": {
    "effect": "^3.19.18",
    "solid-js": "^1.9.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "playwright": "^1.52.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^2.1.8"
  }
}
